# ---------------------------------------------------------------------------
# TEST / staging stack (branch: release) — copy to ".env.docker.test" on the
# server and fill in real secrets. Runs APP_ENV=prod (prod-like) on its own DB.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=mesapplishf-test

# Prod-like build, but a separate stage/domain/database from production.
BUILD_TARGET=prod
APP_ENV=prod

HTTP_PORT=8081
DEFAULT_URI=https://test.mesapplishf.fr

POSTGRES_DB=mesapplishf
POSTGRES_USER=mesapplishf
POSTGRES_PASSWORD=CHANGE_ME_strong_unique_password
DB_PORT=55433

SYMFONY_APP_SECRET=CHANGE_ME_32+_random_hex_chars
SYMFONY_MAILER_DSN=resend+api://ChangeME@default

MERCURE_PORT=3081
MERCURE_PUBLIC_URL=https://test.mesapplishf.fr/.well-known/mercure
MERCURE_CORS_ORIGIN=https://test.mesapplishf.fr
MERCURE_JWT_SECRET=<openssl rand -hex 32>
