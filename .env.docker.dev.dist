# ---------------------------------------------------------------------------
# DEV stack (branch: develop) — copy to ".env.docker.dev" on the server and
# fill in real secrets. Runs APP_ENV=dev with the web profiler & debug tooling.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=mesapplishf-dev

# Dev build target => includes require-dev packages (profiler, maker, etc.).
BUILD_TARGET=dev
APP_ENV=dev

HTTP_PORT=8082
DEFAULT_URI=https://dev.mesapplishf.fr

POSTGRES_DB=mesapplishf
POSTGRES_USER=mesapplishf
POSTGRES_PASSWORD=CHANGE_ME_strong_unique_password
DB_PORT=55434

SYMFONY_APP_SECRET=CHANGE_ME_32+_random_hex_chars
SYMFONY_MAILER_DSN=null://null

MERCURE_PORT=3082
MERCURE_PUBLIC_URL=https://dev.mesapplishf.fr/.well-known/mercure
MERCURE_CORS_ORIGIN=https://dev.mesapplishf.fr
MERCURE_JWT_SECRET=<openssl rand -hex 32>