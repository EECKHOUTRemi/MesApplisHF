# ---------------------------------------------------------------------------
# PRODUCTION stack (branch: main) — copy to ".env.docker.prod" on the server
# and fill in real secrets. This file (.dist) is a committed template only.
# ---------------------------------------------------------------------------

# Compose project name => isolates containers/volumes/network for this stack.
COMPOSE_PROJECT_NAME=mesapplishf-prod

# Image build target and Symfony runtime environment.
BUILD_TARGET=prod
APP_ENV=prod

# Loopback port the host reverse proxy forwards mesapplishf.fr to.
HTTP_PORT=8080
DEFAULT_URI=https://mesapplishf.fr

# Database (internal to this stack only).
POSTGRES_DB=mesapplishf
POSTGRES_USER=mesapplishf
POSTGRES_PASSWORD=CHANGE_ME_strong_unique_password
DB_PORT=55432

# Symfony secrets.
SYMFONY_APP_SECRET=CHANGE_ME_32+_random_hex_chars
SYMFONY_MAILER_DSN=null://null
