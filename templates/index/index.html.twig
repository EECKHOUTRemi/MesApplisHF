{% extends 'base.html.twig' %}

{% block title %}Bienvenue{% endblock %}

{% block body %}
<div class="container d-flex flex-column justify-content-center py-5" style="min-height: calc(100vh - 70px);">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold">Bienvenue <i class="bi bi-stars text-primary"></i>
        <p class="lead text-secondary">Choisissez une section pour commencer :</p>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column">
                    <h1 class="fw-bold mb-1"><i class="bi bi-egg-fried text-primary me-2" aria-hidden="true"></i></h1>
                    <h5 class="card-title">MaCuisine</h5>
                    <p class="card-text text-secondary">Réseau social de partage de recettes.</p>
                    <a href="{{ path('app_ma_cuisine_index') }}" class="btn btn-primary mt-auto" >Ouvrir</a>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column">
                    <h1 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>
                    <h5 class="card-title">MonPoids</h5>
                    <p class="card-text text-secondary">Suivi de votre IMC et de vos mesures corporelles.</p>
                    <a href="{{ path('app_mon_poids_global') }}" class="btn btn-primary mt-auto">Ouvrir</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
