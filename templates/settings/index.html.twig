{% extends 'base.html.twig' %}

{% block title %}Paramètres{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h3 mb-4 d-flex align-items-center gap-2">
                <i class="bi bi-gear-fill text-primary"></i> Paramètres
            </h1>

            {% for label, messages in app.flashes(['success', 'danger']) %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Modifier le profil</h5>
                </div>
                <div class="card-body">
                    {% form_theme profileForm 'bootstrap_5_layout.html.twig' %}
                    {{ form_start(profileForm) }}
                        {{ form_row(profileForm.username) }}
                        {{ form_row(profileForm.email) }}
                        {{ form_row(profileForm.height) }}
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2"></i> Enregistrer
                            </button>
                        </div>
                    {{ form_end(profileForm) }}
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-key-fill me-2 text-primary"></i>Changer le mot de passe</h5>
                </div>
                <div class="card-body">
                    {% form_theme passwordForm 'bootstrap_5_layout.html.twig' %}
                    {{ form_start(passwordForm, { action: path('app_settings_password') }) }}
                        {{ form_row(passwordForm.currentPassword) }}
                        {{ form_row(passwordForm.plainPassword.first) }}
                        {{ form_row(passwordForm.plainPassword.second) }}
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-shield-lock"></i> Mettre à jour
                            </button>
                        </div>
                    {{ form_end(passwordForm) }}
                </div>
            </div>

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger-subtle text-danger-emphasis">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Zone de danger</h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">
                        La suppression de votre compte est <strong>définitive</strong>. Toutes vos données seront effacées et ne pourront pas être récupérées.
                    </p>
                    <form method="post" action="{{ path('app_settings_delete') }}" onsubmit="return confirm('Êtes-vous certain·e de vouloir supprimer définitivement votre compte ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-account-' ~ app.user.id) }}">
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill"></i> Supprimer mon compte
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
