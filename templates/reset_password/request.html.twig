{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="container d-flex flex-column justify-content-center py-5" style="min-height: calc(100vh - 70px);">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4 text-center">
                        <i class="bi bi-key text-primary"></i>
                        Mot de passe oublié
                    </h1>

                    {% for flash_error in app.flashes('reset_password_error') %}
                        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    <p class="text-secondary">
                        Saisissez votre adresse e-mail et nous vous enverrons un lien pour
                        réinitialiser votre mot de passe.
                    </p>

                    {% form_theme requestForm 'bootstrap_5_layout.html.twig' %}

                    {{ form_errors(requestForm) }}

                    {{ form_start(requestForm) }}
                        {{ form_row(requestForm.email, { label: 'Adresse e-mail' }) }}

                        <button type="submit" class="btn btn-primary w-100">
                            Envoyer le lien de réinitialisation
                        </button>
                    {{ form_end(requestForm) }}
                </div>
                <div class="text-center pb-4 px-4">
                    <a href="{{ path('app_login') }}">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        Retour à la connexion
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
