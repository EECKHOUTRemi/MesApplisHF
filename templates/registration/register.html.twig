{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container d-flex flex-column justify-content-center py-5" style="min-height: calc(100vh - 70px);">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4 text-center">
                        <i class="bi bi-person-plus text-primary"></i>
                        Inscription
                    </h1>

                    {% for flash_error in app.flashes('verify_email_error') %}
                        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    {% form_theme registrationForm 'bootstrap_5_layout.html.twig' %}

                    {{ form_errors(registrationForm) }}

                    {{ form_start(registrationForm) }}
                        {{ form_row(registrationForm.email, { label: 'Adresse e-mail' }) }}
                        {{ form_row(registrationForm.username, { label: 'Nom d\'utilisateur' }) }}
                        {{ form_row(registrationForm.plainPassword, { label: 'Mot de passe' }) }}

                        <button type="submit" class="btn btn-primary w-100">S'inscrire</button>
                    {{ form_end(registrationForm) }}
                </div>
                <div class="text-center pb-4 px-4">
                    Déjà un compte ? <a href="{{ path('app_login') }}">Connectez-vous !</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
