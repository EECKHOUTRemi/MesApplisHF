{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container d-flex flex-column justify-content-center py-5" style="min-height: calc(100vh - 70px);">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4 text-center">
                        <i class="bi bi-person-plus text-primary"></i>
                        Inscription
                    </h1>

                    {% for flash_error in app.flashes('verify_email_error') %}
                        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    {% form_theme registrationForm 'bootstrap_5_layout.html.twig' %}

                    {{ form_errors(registrationForm) }}

                    {{ form_start(registrationForm) }}
                        {% include '_required_legend.html.twig' with { form: registrationForm } only %}
                        {{ form_row(registrationForm.email, { label: 'Adresse e-mail' }) }}
                        {{ form_row(registrationForm.username, { label: 'Nom d\'utilisateur' }) }}
                        <div class="mb-3" data-controller="password-toggle">
                            {{ form_label(registrationForm.plainPassword, 'Mot de passe') }}
                            <div class="input-group">
                                {{ form_widget(registrationForm.plainPassword, { attr: { 'data-password-toggle-target': 'input' } }) }}
                                <button type="button" class="btn btn-outline-secondary" aria-label="Afficher le mot de passe" data-password-toggle-target="button" data-action="click->password-toggle#toggle">
                                    <i class="bi bi-eye" aria-hidden="true" data-password-toggle-target="icon"></i>
                                </button>
                            </div>
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>

                        <button type="submit" class="btn btn-primary w-100">S'inscrire</button>
                    {{ form_end(registrationForm) }}
                </div>
                <div class="text-center pb-4 px-4">
                    Déjà un compte ? <a href="{{ path('app_login') }}">Connectez-vous !</a>
                </div>
            </div>
            <p class="text-center mt-3 mb-0">
                <a href="{{ path('app_brochure_index') }}" class="text-secondary text-decoration-none small">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>Découvrir les outils
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
