{% extends 'base.html.twig' %}

{% block title %}Profil — {{ profile.firstName }} {{ profile.lastName }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center p-4">
                    <i class="bi bi-person-circle text-secondary" style="font-size: 6rem;"></i>
                    <h2 class="mt-3 mb-1">{{ profile.firstName }} {{ profile.lastName }}</h2>
                    <p class="text-secondary mb-2">@{{ profile.username }}</p>
                    <p class="mb-3">
                        <i class="bi bi-geo-alt"></i> {{ profile.location }}
                        <span class="mx-2">•</span>
                        <i class="bi bi-envelope"></i> {{ profile.email }}
                    </p>
                    <p class="mb-3">{{ profile.bio }}</p>
                    <p class="text-secondary small mb-3">
                        <i class="bi bi-calendar-event"></i>
                        Membre depuis le {{ profile.memberSince|date('d/m/Y') }}
                    </p>
                    <button type="button" class="btn btn-outline-primary">
                        <i class="bi bi-pencil"></i> Modifier le profil
                    </button>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <i class="bi bi-journal-richtext fs-3 text-primary"></i>
                            <h4 class="mt-2 mb-0">{{ profile.stats.recipes }}</h4>
                            <small class="text-secondary">Recettes</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <i class="bi bi-people-fill fs-3 text-primary"></i>
                            <h4 class="mt-2 mb-0">{{ profile.stats.followers }}</h4>
                            <small class="text-secondary">Abonnés</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <i class="bi bi-person-plus-fill fs-3 text-primary"></i>
                            <h4 class="mt-2 mb-0">{{ profile.stats.following }}</h4>
                            <small class="text-secondary">Abonnements</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <i class="bi bi-speedometer2 fs-3 text-primary"></i>
                            <h4 class="mt-2 mb-0">{{ profile.stats.weighIns }}</h4>
                            <small class="text-secondary">Pesées</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
