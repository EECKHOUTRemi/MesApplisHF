{% extends 'base.html.twig' %}

{% block title %}Profil — {{ profil.username }}{% endblock %}

{% set isConnectedUser = profil.id is same as(app.user.id) %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            {% for label, messages in app.flashes(['success', 'danger']) %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="card shadow-sm mb-4">
                <div class="card-body text-center p-4">
                    {% if isConnectedUser %}
                        <a href="#" class="position-relative d-inline-block text-decoration-none text-reset" data-bs-toggle="modal" data-bs-target="#pfpModal" title="Changer la photo de profil">
                    {% endif %}
                    {% if profil.image %}
                        {% set imgPath = 'uploads/pfp/' ~ profil.image %}
                        {% if imgPath is ondisk %}
                            <picture>
                                <source srcset="{{ asset(imgPath) | imagine_filter('lil_avif') }}" type="image/avif">
                                <source srcset="{{ asset(imgPath) | imagine_filter('lil_webp') }}" type="image/webp">
                                <source srcset="{{ asset(imgPath) | imagine_filter('lil_png') }}" type="image/png">
                                <source srcset="{{ asset(imgPath) | imagine_filter('lil_jpeg') }}" type="image/jpeg">
                                <img src="{{ asset(imgPath)}}" alt="{{ profil.username }}" loading="lazy" class="rounded-4">
                            </picture>
                        {% else %}
                            <div class="banner-fallback">
                                <i class="bi bi-image-alt" aria-hidden="true"></i>
                                <span>Image indisponible</span>
                            </div>
                        {% endif %}
                    {% else %}
                        <i class="bi bi-person-circle text-secondary" style="font-size: 6rem;"></i>
                    {% endif %}
                    
                {% if isConnectedUser %}
                        <i class="bi bi-pencil position-absolute bottom-0 end-0 text-primary" style="font-size: 1.75rem;"></i>
                    </a>
                {% endif %}
                    <h2 class="mt-3 mb-1 d-flex align-items-center justify-content-center gap-2">
                        {{ profil.username }}
                        {% if isConnectedUser %}
                            <a class="d-flex align-items-center gap-2" href="{{ path('app_settings_index') }}" title="Paramètres">
                                <i class="bi bi-gear-fill fs-4" aria-hidden="true"></i>
                                <span class="visually-hidden">Paramètres</span>
                            </a>
                        {% endif %}
                        </h2>

                    {% if not isConnectedUser %}
                        <form action="{{ path('app_friends_sendRequest', { id: profil.id }) }}" method="POST" class="mt-3">
                            {% if relationStatus is same as(null) or relationStatus is same as('refused') %}
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="bi bi-person-plus-fill me-1"></i>Ajouter
                                </button>
                            {% elseif relationStatus is same as('pending') %}
                                <fieldset class="btn-group btn-group-sm" aria-label="Demande d'ami">
                                    <span class="btn btn-warning disabled pe-none">
                                        <i class="bi bi-hourglass-split me-1"></i>Invitation envoyée
                                    </span>
                                    <button type="submit" formaction="{{ path('app_friends_removeRelationship', { user2Id: profil.id }) }}" class="btn btn-outline-danger" title="Annuler la demande">
                                        <i class="bi bi-person-fill-x"></i>
                                    </button>
                                </fieldset>
                            {% elseif relationStatus is same as('accepted') %}
                                <fieldset class="btn-group btn-group-sm" aria-label="Relation d'ami">
                                    <span class="btn btn-success disabled pe-none">
                                        <i class="bi bi-person-check-fill me-1"></i>Ami
                                    </span>
                                    <button type="submit" formaction="{{ path('app_friends_removeRelationship', { user2Id: profil.id }) }}" class="btn btn-outline-danger" title="Supprimer l'ami">
                                        <i class="bi bi-person-fill-x"></i>
                                    </button>
                                </fieldset>
                            {% endif %}
                        </form>
                    {% endif %}

                    {% if isConnectedUser %}
                        <p class="text-secondary mb-3">
                            <i class="bi bi-envelope"></i> {{ profil.email }}
                        </p>
                    {% endif %}
                    
                    <p class="text-secondary small mt-3 mb-0">
                        <i class="bi bi-calendar-event"></i>
                        Membre depuis le {{ profil.createdAt|date('d/m/Y') }}
                    </p>
                </div>
            </div>

            {% if isConnectedUser %}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2 text-primary"></i>Informations</h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="text-secondary"><i class="bi bi-person me-2"></i>Nom d'utilisateur</span>
                            <span class="fw-semibold">{{ profil.username }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="text-secondary"><i class="bi bi-envelope me-2"></i>Email</span>
                            <span class="fw-semibold">{{ profil.email }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="text-secondary"><i class="bi bi-rulers me-2"></i>Taille</span>
                            <span class="fw-semibold">
                                {% if profil.height %}
                                    {{ profil.height }} cm
                                {% else %}
                                    <span class="text-secondary fst-italic">non renseignée</span>
                                {% endif %}
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="text-secondary"><i class="bi bi-shield-check me-2"></i>Statut</span>
                            {% if profil.isVerified %}
                                <span class="badge bg-success-subtle text-success">Vérifié</span>
                            {% else %}
                                <span class="badge bg-warning-subtle text-warning">Non vérifié</span>
                            {% endif %}
                        </li>
                    </ul>
                </div>
            
                <div class="row g-3">
                    <div class="col-md-6">
                        <a href="{{ path('app_macuisine_index') }}" class="card shadow-sm h-100 text-decoration-none text-reset">
                            <div class="card-body d-flex align-items-center gap-3">
                                <i class="bi bi-egg-fried fs-1 text-primary"></i>
                                <div>
                                    <h5 class="mb-1">MaCuisine</h5>
                                    <small class="text-secondary">Vos recettes et votre fil</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="{{ path('app_mon_poids_global') }}" class="card shadow-sm h-100 text-decoration-none text-reset">
                            <div class="card-body d-flex align-items-center gap-3">
                                <i class="bi bi-speedometer2 fs-1 text-primary"></i>
                                <div>
                                    <h5 class="mb-1">MonPoids</h5>
                                    <small class="text-secondary">Votre suivi IMC et mesures</small>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% if isConnectedUser %}
    <div class="modal fade" id="pfpModal" tabindex="-1" aria-labelledby="pfpModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                {% form_theme pictureForm 'bootstrap_5_layout.html.twig' %}
                {{ form_start(pictureForm, { action: path('app_profil_picture') }) }}
                    <div class="modal-header">
                        <h5 class="modal-title" id="pfpModalLabel">
                            <i class="bi bi-camera me-2 text-primary"></i>Changer la photo de profil
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        {{ form_row(pictureForm.image) }}
                        <p class="text-secondary small mb-0">
                            Formats acceptés : AVIF, WebP, JPEG, PNG — 1 Mo maximum.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Annuler
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2"></i> Enregistrer
                        </button>
                    </div>
                {{ form_end(pictureForm) }}
            </div>
        </div>
    </div>
{% endif %}

{% endblock %}
