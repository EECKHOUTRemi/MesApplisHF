{% extends 'base.html.twig' %}

{% block title %}Profil — {{ profil.username }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center p-4">
                    <i class="bi bi-person-circle text-secondary" style="font-size: 6rem;"></i>
                    <h2 class="mt-3 mb-1 d-flex align-items-center justify-content-center gap-2">
                        {{ profil.username }}
                        {% if profil.isVerified %}
                            <i class="bi bi-patch-check-fill text-primary fs-4" title="Compte vérifié"></i>
                        {% endif %}
                    </h2>
                    <p class="text-secondary mb-3">
                        <i class="bi bi-envelope"></i> {{ profil.email }}
                    </p>
                    <p class="text-secondary small mb-0">
                        <i class="bi bi-calendar-event"></i>
                        Membre depuis le {{ profil.createdAt|date('d/m/Y') }}
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2 text-primary"></i>Informations</h5>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-secondary"><i class="bi bi-person me-2"></i>Nom d'utilisateur</span>
                        <span class="fw-semibold">{{ profil.username }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-secondary"><i class="bi bi-envelope me-2"></i>Email</span>
                        <span class="fw-semibold">{{ profil.email }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-secondary"><i class="bi bi-rulers me-2"></i>Taille</span>
                        <span class="fw-semibold">
                            {% if profil.height %}
                                {{ profil.height }} cm
                            {% else %}
                                <span class="text-secondary fst-italic">non renseignée</span>
                            {% endif %}
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-secondary"><i class="bi bi-shield-check me-2"></i>Statut</span>
                        {% if profil.isVerified %}
                            <span class="badge bg-success-subtle text-success">Vérifié</span>
                        {% else %}
                            <span class="badge bg-warning-subtle text-warning">Non vérifié</span>
                        {% endif %}
                    </li>
                </ul>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <a href="{{ path('app_ma_cuisine_index') }}" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="bi bi-egg-fried fs-1 text-primary"></i>
                            <div>
                                <h5 class="mb-1">MaCuisine</h5>
                                <small class="text-secondary">Vos recettes et votre fil</small>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-6">
                    <a href="{{ path('app_mon_poids_global') }}" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="bi bi-speedometer2 fs-1 text-primary"></i>
                            <div>
                                <h5 class="mb-1">MonPoids</h5>
                                <small class="text-secondary">Votre suivi IMC et mesures</small>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
