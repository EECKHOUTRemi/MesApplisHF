{% extends 'base.html.twig' %}

{% block title %}Modifier l'IMC{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="d-flex align-items-center mb-4">
                <a href="{{ path('app_MonPoids_bmi_index') }}" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Modifier l'IMC</h1>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    {{ include('monpoids/bmi/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>
            </div>

            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Zone dangereuse</h5>
                    <p class="text-secondary mb-3">La suppression est définitive et ne peut pas être annulée.</p>
                    {{ include('monpoids/bmi/_delete_form.html.twig', {from: app.request.query.get('from')}) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
