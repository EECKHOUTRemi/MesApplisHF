{% extends 'base.html.twig' %}

{% block title %}Le fil des recettes · MaCuisine{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .feed-wrapper {
            max-width: 680px;
        }
        .feed-header {
            background: linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%);
            color: #fff;
            border-radius: 1rem;
            padding: 1.75rem 1.5rem;
            box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08);
        }
        .feed-post {
            border: 0;
            border-radius: 1rem;
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .feed-post:hover {
            transform: translateY(-2px);
            box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.08);
        }
        .post-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ff7e5f, #feb47b);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.05rem;
            flex-shrink: 0;
        }
        .post-author {
            font-weight: 600;
            color: #212529;
        }
        .post-meta {
            color: #6c757d;
            font-size: .85rem;
        }
        .post-title {
            font-weight: 700;
            font-size: 1.25rem;
            color: #212529;
            text-decoration: none;
        }
        .post-title:hover {
            color: #ff7e5f;
        }
        .post-banner {
            height: 140px;
            border-radius: .75rem;
            background: linear-gradient(135deg, #ffe5d9 0%, #ffc9b0 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: #ff7e5f;
            margin-bottom: 1rem;
        }
        .post-actions .btn {
            color: #6c757d;
            border: 0;
            background: transparent;
            padding: .35rem .65rem;
            border-radius: .5rem;
            font-size: .9rem;
        }
        .post-actions .btn:hover {
            background: #fff5ef;
            color: #ff7e5f;
        }
        .feed-fab {
            position: sticky;
            bottom: 1rem;
            z-index: 5;
        }
    </style>
{% endblock %}

{% block body %}

<div class="container py-4">
    <div class="feed-wrapper mx-auto">

        <section class="feed-header mb-4">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div>
                    <h1 class="h3 fw-bold mb-1"><i class="bi bi-egg-fried me-1" aria-hidden="true"></i>{{ mine ? "Mes recettes" : "Le fil des recettes"}}</h1>
                    <p class="mb-0 small opacity-90">{{ mine ? "Voici vos recettes, celles que vous avez concocté avec amour !" : "Découvrez ce que la communauté a mijoté" }}.</p>
                </div>
                <a href="{{ path('app_ma_cuisine_recipe_new') }}" class="btn btn-light fw-semibold">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Publier une recette
                </a>
            </div>
        </section>

        {# Future searchbar #}
        {# <section class="card feed-post shadow-sm mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="post-avatar">{{ app.user.username|first|upper }}</span>
                <a href="{{ path('app_ma_cuisine_recipe_new') }}" class="flex-grow-1 text-decoration-none">
                    <div class="bg-light rounded-pill px-3 py-2 text-secondary">
                        Quoi de bon dans votre cuisine, {{ app.user.username }}&nbsp;?
                    </div>
                </a>
                <a href="{{ path('app_ma_cuisine_recipe_new') }}" class="btn btn-primary d-none d-sm-inline-flex">
                    <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Nouvelle recette
                </a>
            </div>
        </section> #}

        {% for recipe in recipes %}
            {% set isAuthor = app.user and recipe.author and app.user.id == recipe.author.id %}
            <article class="card feed-post shadow-sm mb-3">
                <div class="card-body">
                    <header class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <span class="post-avatar">{{ recipe.author.username|first|upper }}</span>
                            <div>
                                <div class="post-author">{{ recipe.author.username }}</div>
                                <div class="post-meta">
                                    {% if recipe.createdAt %}
                                        <i class="bi bi-clock me-1" aria-hidden="true"></i>{{ recipe.createdAt|date('d/m/Y à H:i') }}
                                    {% endif %}
                                    {% if recipe.updatedAt and recipe.updatedAt > recipe.createdAt %}
                                        <span class="ms-2"><i class="bi bi-pencil" aria-hidden="true"></i> modifiée</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {% if isAuthor %}
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_ma_cuisine_recipe_edit', {'id': recipe.id}) }}">
                                            <i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Modifier
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="{{ path('app_ma_cuisine_recipe_delete', {'id': recipe.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette recette ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recipe.id) }}">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-trash3 me-2" aria-hidden="true"></i>Supprimer
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        {% endif %}
                    </header>

                    <a href="{{ path('app_ma_cuisine_recipe_show', {'id': recipe.id}) }}" class="text-decoration-none">
                        <div class="post-banner">
                            <i class="bi bi-cup-hot" aria-hidden="true"></i>
                        </div>
                        <h2 class="post-title">{{ recipe.name }}</h2>
                    </a>

                    {% if recipe.refRecipeIngredients|length > 0 %}
                        {% for ri in recipe.refRecipeIngredients %}
                            <span class="mb-5">{{ ri.ingredient.name }}{% if not loop.last %} - {% endif %}</span>
                        {% endfor %}
                    {% else %}
                        <p class="text-body mb-3 mt-2" style="white-space: pre-line;">
                            Pas d'ingrédients renseignés
                        </p>
                    {% endif %}

                    <footer class="post-actions d-flex align-items-center justify-content-between border-top pt-2 mt-3">
                        <a href="{{ path('app_ma_cuisine_recipe_show', {'id': recipe.id}) }}" class="btn">
                            <i class="bi bi-eye me-1" aria-hidden="true"></i>Voir la recette
                        </a>
                        <span class="post-meta">
                            <i class="bi bi-hash" aria-hidden="true"></i>{{ recipe.id }}
                        </span>
                    </footer>
                </div>
            </article>
        {% else %}
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-journal-plus display-4 text-secondary mb-3" aria-hidden="true"></i>
                    <h5>Le fil est encore vide</h5>
                    <p class="text-secondary mb-3">Soyez le premier à partager une recette avec la communauté&nbsp;!</p>
                    <a href="{{ path('app_ma_cuisine_recipe_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Publier ma première recette
                    </a>
                </div>
            </div>
        {% endfor %}

    </div>
</div>
{% endblock %}
