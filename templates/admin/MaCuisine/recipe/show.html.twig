{% extends 'base.html.twig' %}

{% block title %}{{ recipe.name }} · Admin MaCuisine{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('MaCuisine/recipe/_meta_styles.html.twig') }}
{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 720px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'Administration' },
        { label: 'Recettes', path: path('app_admin_macuisine_recipe_index') },
        { label: recipe.name },
    ] }) }}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <h1 class="h4 mb-0 fw-bold"><i class="bi bi-journal-text me-2" aria-hidden="true"></i>{{ recipe.name }}</h1>
        <a href="{{ path('app_admin_macuisine_recipe_edit', {'id': recipe.id}) }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Modifier
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th scope="row" class="text-secondary" style="width: 160px;">Identifiant</th>
                        <td>{{ recipe.id }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Nom</th>
                        <td>{{ recipe.name }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Description</th>
                        <td style="white-space: pre-line;">{{ recipe.description }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Image</th>
                        <td>
                            {% set imgPath = recipe.image ? 'uploads/recipes/' ~ recipe.image : null %}
                            {% if imgPath and imgPath is ondisk %}
                                <img src="{{ asset(imgPath) }}" alt="{{ recipe.name }}" class="rounded" width="96" height="96" style="object-fit: cover;">
                            {% else %}
                                <span class="text-secondary">—</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Auteur</th>
                        <td>{{ recipe.author ? recipe.author.username : '—' }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Catégorie</th>
                        <td>{{ recipe.category ? recipe.category.name : '—' }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Source</th>
                        <td>{{ recipe.source|default('—') }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Détails</th>
                        <td class="d-flex flex-wrap gap-2">
                            {% if recipe.portions or recipe.time or recipe.difficulty or recipe.cost %}
                                {{ include('MaCuisine/recipe/_meta_pills.html.twig', { recipe: recipe }) }}
                            {% else %}
                                <span class="text-secondary">—</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Créée le</th>
                        <td>{{ recipe.createdAt ? recipe.createdAt|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Mise à jour</th>
                        <td>{{ recipe.updatedAt ? recipe.updatedAt|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h6 class="mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Zone de danger</h6>
                <p class="text-secondary mb-0 small">Cette action est définitive.</p>
            </div>
            {{ include('admin/MaCuisine/recipe/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_macuisine_recipe_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}
