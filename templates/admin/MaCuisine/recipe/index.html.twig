{% extends 'base.html.twig' %}

{% block title %}Recettes · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 1100px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_ma_cuisine_index') }}" class="text-decoration-none">MaCuisine</a></li>
            <li class="breadcrumb-item active" aria-current="page">Recettes</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h4 mb-1 fw-bold"><i class="bi bi-journal-text me-2" aria-hidden="true"></i>Recettes</h1>
            <p class="text-secondary mb-0 small">Gestion administrateur des recettes publiées.</p>
        </div>
        <a href="{{ path('app_admin_macuisine_recipe_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouvelle recette
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 70px;">#</th>
                        <th scope="col">Nom</th>
                        <th scope="col" class="d-none d-md-table-cell">Description</th>
                        <th scope="col" class="d-none d-lg-table-cell" style="width: 150px;">Créée le</th>
                        <th scope="col" class="d-none d-lg-table-cell" style="width: 150px;">Mise à jour</th>
                        <th scope="col" class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for recipe in recipes %}
                    <tr>
                        <td class="text-secondary">{{ recipe.id }}</td>
                        <td class="fw-semibold">{{ recipe.name }}</td>
                        <td class="d-none d-md-table-cell text-secondary">
                            {{ recipe.description|length > 80 ? recipe.description|slice(0, 80) ~ '…' : recipe.description }}
                        </td>
                        <td class="d-none d-lg-table-cell text-secondary small">
                            {{ recipe.createdAt ? recipe.createdAt|date('d/m/Y H:i') : '—' }}
                        </td>
                        <td class="d-none d-lg-table-cell text-secondary small">
                            {{ recipe.updatedAt ? recipe.updatedAt|date('d/m/Y H:i') : '—' }}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_macuisine_recipe_show', {'id': recipe.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            <a href="{{ path('app_admin_macuisine_recipe_edit', {'id': recipe.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">
                            <i class="bi bi-inbox d-block fs-3 mb-2" aria-hidden="true"></i>
                            Aucune recette enregistrée.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
