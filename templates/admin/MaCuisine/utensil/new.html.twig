{% extends 'base.html.twig' %}

{% block title %}Nouvel ustensile · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 600px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_macuisine_index') }}" class="text-decoration-none">MaCuisine</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_ma_cuisine_utensil_index') }}" class="text-decoration-none">Ustensiles</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nouveau</li>
        </ol>
    </nav>

    <h1 class="h4 mb-4 fw-bold"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Nouvel ustensile</h1>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ include('admin/MaCuisine/utensil/_form.html.twig', {'button_label': 'Créer'}) }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_ma_cuisine_utensil_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}
