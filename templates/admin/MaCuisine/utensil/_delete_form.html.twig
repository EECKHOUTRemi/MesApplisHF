<form method="post" action="{{ path('app_admin_macuisine_utensil_delete', {'id': utensil.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet ustensile ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ utensil.id) }}">
    <button class="btn btn-outline-danger">
        <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Supprimer
    </button>
</form>
