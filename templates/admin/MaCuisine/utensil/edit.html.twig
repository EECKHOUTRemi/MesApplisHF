{% extends 'base.html.twig' %}

{% block title %}Modifier {{ utensil.name }} · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 600px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_macuisine_index') }}" class="text-decoration-none">MaCuisine</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_ma_cuisine_utensil_index') }}" class="text-decoration-none">Ustensiles</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modifier</li>
        </ol>
    </nav>

    <h1 class="h4 mb-4 fw-bold"><i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Modifier l'ustensile</h1>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ include('admin/MaCuisine/utensil/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h6 class="mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Zone de danger</h6>
                <p class="text-secondary mb-0 small">Cette action est définitive.</p>
            </div>
            {{ include('admin/MaCuisine/utensil/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_ma_cuisine_utensil_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}
