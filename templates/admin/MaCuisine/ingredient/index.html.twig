{% extends 'base.html.twig' %}

{% block title %}Ingrédients · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 900px;">

    {{ include('_back_link.html.twig') }}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h4 mb-1 fw-bold"><i class="bi bi-basket3 me-2" aria-hidden="true"></i>Ingrédients</h1>
            <p class="text-secondary mb-0 small">Gestion administrateur du référentiel.</p>
        </div>
        <a href="{{ path('app_macuisine_ingredient_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouvel ingrédient
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 80px;">#</th>
                        <th scope="col">Nom</th>
                        <th scope="col" class="text-end" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for ingredient in ingredients %}
                    <tr>
                        <td class="text-secondary">{{ ingredient.id }}</td>
                        <td class="fw-semibold">{{ ingredient.name }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_macuisine_ingredient_show', {'id': ingredient.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            <a href="{{ path('app_macuisine_ingredient_edit', {'id': ingredient.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-secondary py-4">
                            <i class="bi bi-inbox d-block fs-3 mb-2" aria-hidden="true"></i>
                            Aucun ingrédient enregistré.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
