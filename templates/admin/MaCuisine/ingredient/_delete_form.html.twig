<form method="post" action="{{ path('app_macuisine_ingredient_delete', {'id': ingredient.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet ingrédient ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ingredient.id) }}">
    <button class="btn btn-outline-danger">
        <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Supprimer
    </button>
</form>
