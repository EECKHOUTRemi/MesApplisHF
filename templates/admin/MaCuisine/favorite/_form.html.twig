{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form) }}
    {% include '_required_legend.html.twig' with { form: form } only %}
    {{ form_row(form.user, {'label': 'Utilisateur'}) }}
    {{ form_row(form.recipe, {'label': 'Recette'}) }}
    {{ form_row(form.createdAt, {'label': 'Ajouté le'}) }}

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>{{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}
