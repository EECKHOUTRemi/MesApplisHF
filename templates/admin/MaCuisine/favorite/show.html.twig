{% extends 'base.html.twig' %}

{% block title %}Favori #{{ favorite.id }} · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 600px;">

    {{ include('_back_link.html.twig') }}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <h1 class="h4 mb-0 fw-bold"><i class="bi bi-star-fill me-2" aria-hidden="true"></i>Favori #{{ favorite.id }}</h1>
        <a href="{{ path('app_admin_ma_cuisine_favorite_edit', {'id': favorite.id}) }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Modifier
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th scope="row" class="text-secondary" style="width: 140px;">Identifiant</th>
                        <td>{{ favorite.id }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Utilisateur</th>
                        <td>
                            <a href="{{ path('app_user_show', {'id': favorite.user.id}) }}" class="text-decoration-none">
                                {{ favorite.user.username }}
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Recette</th>
                        <td>
                            <a href="{{ path('app_admin_macuisine_recipe_show', {'id': favorite.recipe.id}) }}" class="text-decoration-none">
                                {{ favorite.recipe.name }}
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Ajouté le</th>
                        <td>{{ favorite.createdAt ? favorite.createdAt|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h6 class="mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Zone de danger</h6>
                <p class="text-secondary mb-0 small">Cette action est définitive.</p>
            </div>
            {{ include('admin/MaCuisine/favorite/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_ma_cuisine_favorite_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}
