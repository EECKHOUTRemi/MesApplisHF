{% extends 'base.html.twig' %}

{% block title %}Favoris · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 1000px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'Administration' },
        { label: 'Favoris' },
    ] }) }}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h4 mb-1 fw-bold"><i class="bi bi-star-fill me-2" aria-hidden="true"></i>Favoris</h1>
            <p class="text-secondary mb-0 small">Gestion administrateur des recettes mises en favori.</p>
        </div>
        <a href="{{ path('app_admin_ma_cuisine_favorite_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouveau favori
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 70px;">#</th>
                        <th scope="col">Utilisateur</th>
                        <th scope="col">Recette</th>
                        <th scope="col" class="d-none d-md-table-cell" style="width: 170px;">Ajouté le</th>
                        <th scope="col" class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for favorite in favorites %}
                    <tr>
                        <td class="text-secondary">{{ favorite.id }}</td>
                        <td class="fw-semibold">
                            <a href="{{ path('app_user_show', {'id': favorite.user.id}) }}" class="text-decoration-none">
                                {{ favorite.user.username }}
                            </a>
                        </td>
                        <td>
                            <a href="{{ path('app_admin_macuisine_recipe_show', {'id': favorite.recipe.id}) }}" class="text-decoration-none">
                                {{ favorite.recipe.name }}
                            </a>
                        </td>
                        <td class="d-none d-md-table-cell text-secondary small">
                            {{ favorite.createdAt ? favorite.createdAt|date('d/m/Y H:i') : '—' }}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_ma_cuisine_favorite_show', {'id': favorite.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            <a href="{{ path('app_admin_ma_cuisine_favorite_edit', {'id': favorite.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-4">
                            <i class="bi bi-inbox d-block fs-3 mb-2" aria-hidden="true"></i>
                            Aucun favori enregistré.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
