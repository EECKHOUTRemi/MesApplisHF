{% extends 'base.html.twig' %}

{% block title %}Nouvelle catégorie · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 600px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'Administration' },
        { label: 'Catégories', path: path('app_admin_ma_cuisine_category_index') },
        { label: 'Nouvelle catégorie' },
    ] }) }}

    <h1 class="h4 mb-4 fw-bold"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Nouvelle catégorie</h1>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ include('admin/MaCuisine/category/_form.html.twig', {'button_label': 'Créer'}) }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_ma_cuisine_category_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}
