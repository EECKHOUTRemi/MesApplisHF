{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 600px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'Administration' },
        { label: 'Catégories', path: path('app_admin_macuisine_category_index') },
        { label: category.name },
    ] }) }}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <h1 class="h4 mb-0 fw-bold"><i class="bi bi-tag-fill me-2" aria-hidden="true"></i>{{ category.name }}</h1>
        <a href="{{ path('app_admin_macuisine_category_edit', {'id': category.id}) }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Modifier
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th scope="row" class="text-secondary" style="width: 140px;">Identifiant</th>
                        <td>{{ category.id }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Nom</th>
                        <td>{{ category.name }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Créée le</th>
                        <td>{{ category.createdAt ? category.createdAt|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Mise à jour</th>
                        <td>{{ category.updatedAt ? category.updatedAt|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h6 class="mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Zone de danger</h6>
                <p class="text-secondary mb-0 small">Cette action est définitive.</p>
            </div>
            {{ include('admin/MaCuisine/category/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_macuisine_category_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}
