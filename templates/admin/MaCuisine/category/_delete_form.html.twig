<form method="post" action="{{ path('app_admin_macuisine_category_delete', {'id': category.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette catégorie ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    <button class="btn btn-outline-danger">
        <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Supprimer
    </button>
</form>
