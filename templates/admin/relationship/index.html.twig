{% extends 'base.html.twig' %}

{% block title %}Relations · Admin{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 1100px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'Administration' },
        { label: 'Relations' },
    ] }) }}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h4 mb-1 fw-bold"><i class="bi bi-people me-2" aria-hidden="true"></i>Relations</h1>
            <p class="text-secondary mb-0 small">Gestion administrateur des relations entre utilisateurs.</p>
        </div>
        <a href="{{ path('app_admin_relationship_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouvelle relation
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 70px;">#</th>
                        <th scope="col">Relation</th>
                        <th scope="col" style="width: 130px;">Statut</th>
                        <th scope="col" class="d-none d-md-table-cell" style="width: 170px;">Créée le</th>
                        <th scope="col" class="d-none d-lg-table-cell" style="width: 170px;">Mise à jour</th>
                        <th scope="col" class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for relationship in relationships %}
                    <tr>
                        <td class="text-secondary">{{ relationship.id }}</td>
                        <td>
                            {# Le sens compte : user1 a envoyé la demande, user2 l'a reçue. #}
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                {{ include('admin/relationship/_user_link.html.twig', { user: relationship.user1 }, with_context = false) }}
                                <i class="bi bi-arrow-right text-secondary" aria-hidden="true"></i>
                                <span class="visually-hidden">a envoyé une demande à</span>
                                {{ include('admin/relationship/_user_link.html.twig', { user: relationship.user2 }, with_context = false) }}
                            </div>
                        </td>
                        <td>
                            <span class="badge {{ relationship.accepted ? 'text-bg-success' : 'text-bg-warning' }}">
                                <i class="bi {{ relationship.accepted ? 'bi-check-circle' : 'bi-hourglass-split' }}" aria-hidden="true"></i>
                                {{ relationship.statusLabel }}
                            </span>
                        </td>
                        <td class="d-none d-md-table-cell text-secondary small">
                            {{ relationship.createdAt ? relationship.createdAt|date('d/m/Y H:i') : '—' }}
                        </td>
                        <td class="d-none d-lg-table-cell text-secondary small">
                            {{ relationship.updatedAt ? relationship.updatedAt|date('d/m/Y H:i') : '—' }}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_relationship_show', {'id': relationship.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            <a href="{{ path('app_admin_relationship_edit', {'id': relationship.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">
                            <i class="bi bi-inbox d-block fs-3 mb-2" aria-hidden="true"></i>
                            Aucune relation enregistrée.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
