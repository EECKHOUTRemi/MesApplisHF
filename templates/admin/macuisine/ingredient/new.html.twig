{% extends 'base.html.twig' %}

{% block title %}Nouvel ingrédient · Admin MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 600px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_ma_cuisine_index') }}" class="text-decoration-none">MaCuisine</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_ma_cuisine_ingredient_index') }}" class="text-decoration-none">Ingrédients</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nouveau</li>
        </ol>
    </nav>

    <h1 class="h4 mb-4 fw-bold"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Nouvel ingrédient</h1>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ include('admin/ingredient/_form.html.twig', {'button_label': 'Créer'}) }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_ma_cuisine_ingredient_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour à la liste
        </a>
    </div>

</div>
{% endblock %}
