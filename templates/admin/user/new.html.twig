{% extends 'base.html.twig' %}

{% block title %}Nouvel utilisateur · Admin{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 720px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'Administration' },
        { label: 'Utilisateurs', path: path('app_admin_user_index') },
        { label: 'Nouvel utilisateur' },
    ] }) }}

    <h1 class="h4 mb-4 fw-bold"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Nouvel utilisateur</h1>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ include('admin/user/_form.html.twig', {'button_label': 'Créer'}) }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_user_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}
