{% extends 'base.html.twig' %}

{% block title %}Utilisateurs · Admin{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 1100px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_index') }}" class="text-decoration-none">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">Utilisateurs</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h4 mb-1 fw-bold"><i class="bi bi-people-fill me-2" aria-hidden="true"></i>Utilisateurs</h1>
            <p class="text-secondary mb-0 small">Gestion administrateur des comptes.</p>
        </div>
        <a href="{{ path('app_user_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouvel utilisateur
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 70px;">#</th>
                        <th scope="col">Email</th>
                        <th scope="col" class="d-none d-md-table-cell">Nom d'utilisateur</th>
                        <th scope="col" class="d-none d-lg-table-cell">Rôles</th>
                        <th scope="col" style="width: 110px;">Vérifié</th>
                        <th scope="col" class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="text-secondary">{{ user.id }}</td>
                        <td class="fw-semibold">{{ user.email }}</td>
                        <td class="d-none d-md-table-cell">{{ user.username }}</td>
                        <td class="d-none d-lg-table-cell">
                            {% for role in user.roles %}
                                <span class="badge {{ role == 'ROLE_ADMIN' ? 'text-bg-danger' : 'text-bg-secondary' }}">{{ role }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            {% if user.isVerified %}
                                <span class="badge text-bg-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Oui</span>
                            {% else %}
                                <span class="badge text-bg-warning"><i class="bi bi-x-circle" aria-hidden="true"></i> Non</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">
                            <i class="bi bi-inbox d-block fs-3 mb-2" aria-hidden="true"></i>
                            Aucun utilisateur enregistré.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
