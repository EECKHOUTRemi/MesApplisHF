{% extends 'base.html.twig' %}

{% block title %}{{ user.username }} · Admin{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 720px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'Administration' },
        { label: 'Utilisateurs', path: path('app_admin_user_index') },
        { label: user.username },
    ] }) }}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <h1 class="h4 mb-0 fw-bold"><i class="bi bi-person-fill me-2" aria-hidden="true"></i>{{ user.username }}</h1>
        <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Modifier
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th scope="row" class="text-secondary" style="width: 160px;">Photo</th>
                        <td>
                            {% set imgPath = user.image ? 'uploads/pfp/' ~ user.image : null %}
                            {% if imgPath and imgPath is ondisk %}
                                <img src="{{ asset(imgPath) }}" alt="{{ user.username }}" class="rounded-circle" width="48" height="48" style="object-fit: cover;">
                            {% else %}
                                <span class="text-secondary">—</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Identifiant</th>
                        <td>{{ user.id }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">E-mail</th>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Nom d'utilisateur</th>
                        <td>{{ user.username }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Rôles</th>
                        <td>
                            {% for role in user.roles %}
                                <span class="badge {{ role == 'ROLE_ADMIN' ? 'text-bg-danger' : 'text-bg-secondary' }}">{{ role }}</span>
                            {% endfor %}
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Taille</th>
                        <td>{{ user.height ? user.height ~ ' cm' : '—' }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Vérifié</th>
                        <td>
                            {% if user.isVerified %}
                                <span class="badge text-bg-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Oui</span>
                            {% else %}
                                <span class="badge text-bg-warning"><i class="bi bi-x-circle" aria-hidden="true"></i> Non</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-secondary">Inscrit le</th>
                        <td>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h6 class="mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Zone de danger</h6>
                <p class="text-secondary mb-0 small">Cette action est définitive.</p>
            </div>
            {{ include('admin/user/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_user_index') }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}
