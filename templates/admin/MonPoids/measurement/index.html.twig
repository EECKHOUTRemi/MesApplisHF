{% extends 'base.html.twig' %}

{% block title %}Mesures · Admin MonPoids{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 1100px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'Administration' },
        { label: 'Mensurations' },
    ] }) }}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h4 mb-1 fw-bold"><i class="bi bi-rulers me-2" aria-hidden="true"></i>Mesures</h1>
            <p class="text-secondary mb-0 small">Gestion administrateur des mensurations.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 70px;">#</th>
                        <th scope="col">Utilisateur</th>
                        <th scope="col" class="d-none d-md-table-cell">Poitrine (cm)</th>
                        <th scope="col" class="d-none d-md-table-cell">Hanches (cm)</th>
                        <th scope="col" class="d-none d-lg-table-cell">Cuisse (cm)</th>
                        <th scope="col" class="d-none d-lg-table-cell">Taille (cm)</th>
                        <th scope="col" class="d-none d-lg-table-cell" style="width: 170px;">Date</th>
                        <th scope="col" class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for measurement in measurements %}
                    <tr>
                        <td class="text-secondary">{{ measurement.id }}</td>
                        <td class="fw-semibold">{{ measurement.user.email }} <span class="text-secondary small">({{ measurement.user.username }})</span></td>
                        <td class="d-none d-md-table-cell">{{ measurement.chest }}</td>
                        <td class="d-none d-md-table-cell">{{ measurement.hips }}</td>
                        <td class="d-none d-lg-table-cell">{{ measurement.thigh }}</td>
                        <td class="d-none d-lg-table-cell">{{ measurement.waist }}</td>
                        <td class="d-none d-lg-table-cell text-secondary small">
                            {{ measurement.createdAt ? measurement.createdAt|date('d/m/Y H:i') : '—' }}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_MonPoids_measurement_show', {'id': measurement.id, 'from': 'admin'}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            <a href="{{ path('app_MonPoids_measurement_edit', {'id': measurement.id, 'from': 'admin'}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-4">
                            <i class="bi bi-inbox d-block fs-3 mb-2" aria-hidden="true"></i>
                            Aucune mesure enregistrée.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
