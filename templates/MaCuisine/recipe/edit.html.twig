{% extends 'base.html.twig' %}

{% block title %}Modifier {{ recipe.name }} · MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 760px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'MaCuisine', path: path('app_macuisine_index') },
        { label: 'Recettes', path: path('app_macuisine_feed') },
        { label: recipe.name, path: path('app_macuisine_recipe_show', {'id': recipe.id}) },
        { label: 'Modifier' },
    ] }) }}

    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 text-warning" style="width:56px;height:56px;font-size:1.5rem;">
            <i class="bi bi-pencil-square" aria-hidden="true"></i>
        </span>
        <div>
            <h1 class="h3 mb-1 fw-bold">Modifier la recette</h1>
            <p class="text-secondary mb-0">Mettez à jour <strong>{{ recipe.name }}</strong>.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ include('MaCuisine/recipe/_form.html.twig', {'button_label': 'Mettre à jour', 'ingredients': ingredients}) }}
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h5 class="mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Zone de danger</h5>
                <p class="text-secondary mb-0 small">Supprimer cette recette est définitif&nbsp;: cette action ne peut pas être annulée.</p>
            </div>
            <form method="post" action="{{ path('app_macuisine_recipe_delete', {'id': recipe.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette recette ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recipe.id) }}">
                <button class="btn btn-outline-danger">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Supprimer la recette
                </button>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_macuisine_recipe_show', {'id': recipe.id}) }}" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour à la recette
        </a>
    </div>

</div>
{% endblock %}

{% block importmap %}{{ importmap(['app', 'MaCuisine/select-ingredient', 'MaCuisine/select-utensil']) }}{% endblock %}
