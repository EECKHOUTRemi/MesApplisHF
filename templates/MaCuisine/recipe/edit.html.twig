{% extends 'base.html.twig' %}

{% block title %}Modifier {{ recipe.name }} · MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 760px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_ma_cuisine_index') }}" class="text-decoration-none">MaCuisine</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_ma_cuisine_recipe_index') }}" class="text-decoration-none">Recettes</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_ma_cuisine_recipe_show', {'id': recipe.id}) }}" class="text-decoration-none">{{ recipe.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modifier</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 text-warning" style="width:56px;height:56px;font-size:1.5rem;">
            <i class="bi bi-pencil-square" aria-hidden="true"></i>
        </span>
        <div>
            <h1 class="h3 mb-1 fw-bold">Modifier la recette</h1>
            <p class="text-secondary mb-0">Mettez à jour <strong>{{ recipe.name }}</strong>.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ include('macuisine/recipe/_form.html.twig', {'button_label': 'Mettre à jour', 'ingredients': ingredients}) }}
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h5 class="mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Zone de danger</h5>
                <p class="text-secondary mb-0 small">Supprimer cette recette est définitif&nbsp;: cette action ne peut pas être annulée.</p>
            </div>
            <form method="post" action="{{ path('app_ma_cuisine_recipe_delete', {'id': recipe.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette recette ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recipe.id) }}">
                <button class="btn btn-outline-danger">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Supprimer la recette
                </button>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a href="javascript:history.back()" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}

{% block importmap %}{{ importmap(['app', 'macuisine/select-ingredient']) }}{% endblock %}
