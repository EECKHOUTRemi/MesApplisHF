{% form_theme form 'bootstrap_5_layout.html.twig' 'MaCuisine/recipe/_icon_rating_theme.html.twig' %}

{{ form_start(form, {'attr': {'class': 'recipe-form'}}) }}
    {% include '_required_legend.html.twig' with { form: form } only %}
    <div class="row g-3">
        <div class="col-12">
            {{ form_row(form.name, {'label': 'Nom de la recette', 'attr': {'placeholder': 'Ex. Tarte aux pommes de mamie'}}) }}
        </div>
        <div class="col-12">
            {{ form_row(form.image, {'label': 'Image de la recette', 'attr': {'placeholder': 'Ex. Tarte aux pommes de mamie'}}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.utensil, {
                'label': 'Ustensiles nécessaires',
                'attr': {
                    'data-options': (utensils ?? [])|json_encode,
                    'data-initial': (selectedUtensils ?? [])|json_encode,
                },
            }) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.category, {'label': 'Catégorie'}) }}
        </div>
        <div class="col-12">
            {{ form_row(form.description, {'label': 'Description', 'attr': {'placeholder': 'Décrivez votre recette, les étapes, les astuces…', 'rows': 6}}) }}
        </div>
        <div class="col-12">
            {{ form_row(form.source, {'label': 'Source', 'attr': {'placeholder': 'Indiquez la source de cette recette'}}) }}
        </div>
        <div class="col-12">
            {{ form_label(form.ingredients, 'Ingrédients') }}
            {{ form_widget(form.ingredients, {
                'attr': {
                    'placeholder': 'Listez les ingrédients nécessaires…',
                    'data-ajax-url': path('app_macuisine_recipe_ingredients_ajax'),
                    'data-initial': (ingredients ?? {})|json_encode,
                }
            }) }}
            {{ form_errors(form.ingredients) }}

            <div class="ingredient-extras mt-2"></div>
        </div>
        <div>
            {{ form_row(form.portions, {'label': 'Nombre de portions (en personnes)'}) }}
        </div>
        <div>
            {{ form_row(form.time, {'label': 'Temps de préparation (en min)'}) }}
        </div>
        <div>
            {{ form_row(form.difficulty, {'label': 'Difficulté'}) }}
        </div>
        <div>
            {{ form_row(form.cost, {'label': 'Prix'}) }}
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>{{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}

<style>
    .icon-rating {
        direction: rtl;
        display: inline-block;
        cursor: pointer;
    }

    /* Masqué visuellement mais toujours focusable au clavier (display:none le sortirait
       de l'ordre de tabulation) ; position:absolute évite qu'il occupe de la place. */
    .icon-rating input {
        position: absolute;
        opacity: 0;
        width: 1px;
        height: 1px;
    }

    .icon-rating label {
        display: inline-block;
        color: #ddd;
        font-size: 24px;
        line-height: 1;
        padding: 0 2px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .icon-rating input:focus-visible + label {
        outline: 2px solid var(--bs-primary, #0d6efd);
        outline-offset: 2px;
        border-radius: .2rem;
    }

    .icon-rating-difficulty label:hover,
    .icon-rating-difficulty label:hover ~ label,
    .icon-rating-difficulty input:checked ~ label {
        color: #dc3545;
    }

    .icon-rating-cost label:hover,
    .icon-rating-cost label:hover ~ label,
    .icon-rating-cost input:checked ~ label {
        color: #efd42b;
    }
</style>

<script>
    document.querySelectorAll('.icon-rating label').forEach(function (icon) {
        icon.addEventListener('click', function () {
            this.style.transform = 'scale(1.2)';
            setTimeout(() => {
                this.style.transform = 'scale(1)';
            }, 200);
        });
    });
</script>
