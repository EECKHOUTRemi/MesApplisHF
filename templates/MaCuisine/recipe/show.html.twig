{% extends 'base.html.twig' %}

{% block title %}{{ recipe.name }} · MaCuisine{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .recipe-hero {
            background: linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%);
            color: #fff;
            border-radius: 1rem;
            padding: 2.5rem 2rem;
            box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08);
        }
        .recipe-hero .recipe-emoji {
            font-size: 4rem;
            opacity: .9;
        }
        .post-banner picture {
            display: block;
            width: 100%;
        }
        .post-banner img {
            width: 100%;
            height: 170px;
            object-fit: cover;
            border-radius: .75rem;
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.18);
        }
        .banner-fallback {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .35rem;
            color: #fff;
            opacity: .9;
        }
        .banner-fallback i {
            font-size: 2.5rem;
        }
        .banner-fallback span {
            font-size: .85rem;
            font-weight: 500;
        }
        .author-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #ff7e5f;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.05rem;
        }
        .recipe-description {
            white-space: pre-line;
            line-height: 1.7;
            font-size: 1.05rem;
        }
    </style>
    {{ include('MaCuisine/recipe/_meta_styles.html.twig') }}
{% endblock %}

{% block body %}

{% set isAuthor = app.user and recipe.author and app.user.id == recipe.author.id %}
{% set unitLabels = {
    'kg': 'kg',
    'g':  'g',
    'mg': 'mg',
    'l':  'l',
    'ml': 'ml',
    'cc': 'cuillère(s) à café',
    'cs': 'cuillère(s) à soupe',
    'p':  'pincée(s)',
    'u':  'unité(s)',
} %}

<div class="container py-4" style="max-width: 820px;">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'MaCuisine', path: path('app_macuisine_index') },
        { label: 'Recettes', path: path('app_macuisine_feed') },
        { label: recipe.name },
    ] }) }}

    <section class="recipe-hero mb-4">
        <div class="row align-items-center g-3">
            <div class="col-md-9">
                <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                    <span class="badge bg-light text-dark"><i class="bi bi-egg-fried me-1" aria-hidden="true"></i>Recette</span>
                    {% if recipe.category %}
                        <span class="badge text-bg-warning"><i class="bi bi-tag-fill me-1" aria-hidden="true"></i>{{ recipe.category.name }}</span>
                    {% endif %}

                    <form method="post" action="{{ path('app_macuisine_favorite_toggle') }}" class="ms-1 d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('favorite' ~ recipe.id) }}">
                        <input type="hidden" name="recipeId" value="{{ recipe.id }}">
                        <button type="submit" class="btn btn-link p-0 border-0 align-baseline" style="color: yellow;"
                                title="{{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">
                            <i class="bi bi-star{{ isFavorite ? '-fill' : '' }}" style="font-size: 1.5rem;"></i>
                        </button>
                    </form>
                </div>
                <h1 class="display-5 fw-bold mb-2">{{ recipe.name }}</h1>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        {% if recipe.author.username %}
                            {% set author = recipe.author %}
                            <a href="{{ path('app_profil_seeOtherUser', { id: author.id }) }}" class="text-decoration-none" style="color: white;">
                                {% set imgPath = author.image ? 'uploads/pfp/' ~ author.image : null %}
                                {% if imgPath and imgPath is ondisk %}
                                    <picture class="me-2">
                                        <source srcset="{{ asset(imgPath) | imagine_filter('tiny_avif') }}" type="image/avif">
                                        <source srcset="{{ asset(imgPath) | imagine_filter('tiny_webp') }}" type="image/webp">
                                        <source srcset="{{ asset(imgPath) | imagine_filter('tiny_png') }}" type="image/png">
                                        <source srcset="{{ asset(imgPath) | imagine_filter('tiny_jpeg') }}" type="image/jpeg">
                                        <img src="{{ asset(imgPath) }}" alt="Profil" loading="lazy" class="rounded-circle" width="32" height="32" style="object-fit: cover;">
                                    </picture>
                                {% else %}
                                    <span class="author-avatar">{{ (author.username)|first|upper }}</span>
                                {% endif %}
                                <span>par <strong>{{ author.username }}</strong></span>
                            </a>
                        {% else %}
                            <span class="author-avatar">C</span>
                            <span>par <strong>Compte supprimé</strong></span>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-md-3 text-center d-none d-md-block">
            <div class="post-banner">
            {% if recipe.image %}
                {% set imgPath = 'uploads/recipes/' ~ recipe.image %}
                {% if imgPath is ondisk %}
                    <picture>
                        <source srcset="{{ asset(imgPath) | imagine_filter('lil_avif') }}" type="image/avif">
                        <source srcset="{{ asset(imgPath) | imagine_filter('lil_webp') }}" type="image/webp">
                        <source srcset="{{ asset(imgPath) | imagine_filter('lil_png') }}" type="image/png">
                        <source srcset="{{ asset(imgPath) | imagine_filter('lil_jpeg') }}" type="image/jpeg">
                        <img src="{{ asset(imgPath)}}" alt="{{ recipe.name }}" loading="lazy">
                    </picture>
                {% else %}
                    <div class="banner-fallback">
                        <i class="bi bi-image-alt" aria-hidden="true"></i>
                        <span>Image indisponible</span>
                    </div>
                {% endif %}
            {% else %}
                <span class="recipe-emoji"><i class="bi bi-fork-knife" aria-hidden="true"></i></span>
            {% endif %}
            </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap gap-2 mb-3">
                {% if recipe.createdAt %}
                    <span class="meta-pill">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>Publiée le {{ recipe.createdAt|date('d/m/Y') }}
                    </span>
                {% endif %}
                {% if recipe.updatedAt %}
                    <span class="meta-pill">
                        <i class="bi bi-pencil" aria-hidden="true"></i>Mise à jour le {{ recipe.updatedAt|date('d/m/Y') }}
                    </span>
                {% endif %}
                {{ include('MaCuisine/recipe/_meta_pills.html.twig', { recipe: recipe }) }}
            </div>

            <p class="mb-3">
                {{ include('MaCuisine/recipe/_favorite_count.html.twig', { count: favoriteCount }) }}
            </p>

            {% if recipe.utensil|length > 0 %}
                <h2 class="h5 fw-bold mb-2"><i class="bi bi-tools text-primary me-1" aria-hidden="true"></i>Ustensiles</h2>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    {% for utensil in recipe.utensil %}
                        <span class="badge rounded-pill text-bg-light border">{{ utensil.name }}</span>
                    {% endfor %}
                </div>
            {% endif %}

            {% if recipe.refRecipeIngredients|length > 0 %}
                <h2 class="h5 fw-bold mb-3"><i class="bi bi-basket text-primary me-1" aria-hidden="true"></i>Ingrédients</h2>
                <ul class="list-group list-group-flush">
                    {% for ri in recipe.refRecipeIngredients %}
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>{{ ri.ingredient.name }}</span>
                            <span class="text-secondary">
                                {% if ri.quantity > 0 %}
                                    {{ ri.quantity }} {{ unitLabels[ri.unite]|default(ri.unite) }}
                                {% else %}
                                    Pas de quantité précisée
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-2"><i class="bi bi-journal-text text-primary me-1" aria-hidden="true"></i>Description</h2>
            <p class="recipe-description text-body mb-0">{{ recipe.description }}</p>

        </div>
    </section>

    <div class="d-flex flex-wrap gap-2 justify-content-between">
        {% if isAuthor %}
            <div class="d-flex gap-2">
                <a href="{{ path('app_macuisine_recipe_edit', {'id': recipe.id}) }}" class="btn btn-warning">
                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Modifier
                </a>
                <form method="post" action="{{ path('app_macuisine_recipe_delete', {'id': recipe.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette recette ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recipe.id) }}">
                    <button class="btn btn-outline-danger">
                        <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Supprimer
                    </button>
                </form>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
