{% extends 'base.html.twig' %}

{% block title %}Le fil des recettes · MaCuisine{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .feed-wrapper {
            max-width: 680px;
        }
        .feed-header {
            background: linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%);
            color: #fff;
            border-radius: 1rem;
            padding: 1.75rem 1.5rem;
            box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08);
        }
        .feed-post {
            border: 0;
            border-radius: 1rem;
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .feed-post:hover {
            transform: translateY(-2px);
            box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.08);
        }
        .post-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ff7e5f, #feb47b);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.05rem;
            flex-shrink: 0;
        }
        .post-author {
            font-weight: 600;
            color: #212529;
        }
        .post-meta {
            color: #6c757d;
            font-size: .85rem;
        }
        .post-title {
            font-weight: 700;
            font-size: 1.25rem;
            color: #212529;
            text-decoration: none;
        }
        .post-title:hover {
            color: #ff7e5f;
        }
        .post-banner {
            height: 300px;
            border-radius: .75rem;
            background: linear-gradient(135deg, #ffe5d9 0%, #ffc9b0 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: #ff7e5f;
            margin-bottom: 1rem;
            overflow: hidden;
        }
        .post-banner picture {
            display: block;
            width: 100%;
            height: 100%;
        }
        .post-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .3s ease;
        }
        .feed-post:hover .post-banner img {
            transform: scale(1.04);
        }
        .banner-fallback {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .4rem;
            color: #d98a6c;
        }
        .banner-fallback i {
            font-size: 2.75rem;
            opacity: .8;
        }
        .banner-fallback span {
            font-size: .9rem;
            font-weight: 500;
        }
        .post-actions .btn {
            color: #6c757d;
            border: 0;
            background: transparent;
            padding: .35rem .65rem;
            border-radius: .5rem;
            font-size: .9rem;
        }
        .post-actions .btn:hover {
            background: #fff5ef;
            color: #ff7e5f;
        }
        .feed-fab {
            position: sticky;
            bottom: 1rem;
            z-index: 5;
        }
    </style>
{% endblock %}

{% block body %}

<div class="container py-4">
    <div class="feed-wrapper mx-auto">

        <section class="feed-header mb-4">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div>
                    <h1 class="h3 fw-bold mb-1"><i class="bi bi-egg-fried me-1" aria-hidden="true"></i>{{ mine ? "Mes recettes" : "Le fil des recettes"}}</h1>
                    <p class="mb-0 small opacity-90">{{ mine ? "Voici vos recettes, celles que vous avez concocté avec amour !" : "Découvrez ce que la communauté a mijoté" }}.</p>
                </div>
                <a href="{{ path('app_macuisine_recipe_new') }}" class="btn btn-light fw-semibold">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Publier une recette
                </a>
            </div>
        </section>

        {# Recherche & filtres #}
        {% set searchQuery = app.request.query.get('q') %}
        {% set selectedIngredients = app.request.query.all('ingredients') %}
        {% set selectedUtensils = app.request.query.all('utensils') %}
        {% set selectedCategories = app.request.query.all('categories') %}
        {% set activeFilterCount = selectedIngredients|length + selectedUtensils|length + selectedCategories|length %}

        <section class="card feed-post shadow-sm mb-3">
            <div class="card-body">
                <form method="get" action="{{ path('app_macuisine_feed') }}" class="recipe-search">
                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 rounded-pill rounded-end-0">
                                <i class="bi bi-search text-secondary" aria-hidden="true"></i>
                            </span>
                            <input type="search" name="q" value="{{ searchQuery }}"
                                   class="form-control border-0 bg-light rounded-pill rounded-start-0"
                                   placeholder="Rechercher par nom…" aria-label="Rechercher par nom">
                        </div>
                        <button class="btn btn-primary rounded-pill px-3 flex-shrink-0" type="submit">
                            <i class="bi bi-search me-1 d-none d-sm-inline" aria-hidden="true"></i>Rechercher
                        </button>
                        <button class="btn btn-light rounded-pill px-3 flex-shrink-0" type="button"
                                data-bs-toggle="collapse" data-bs-target="#recipeFilters"
                                aria-expanded="{{ activeFilterCount > 0 ? 'true' : 'false' }}" aria-controls="recipeFilters">
                            <i class="bi bi-sliders me-1" aria-hidden="true"></i><span class="d-none d-sm-inline">Filtres</span>
                            {% if activeFilterCount > 0 %}<span class="badge text-bg-primary ms-1">{{ activeFilterCount }}</span>{% endif %}
                        </button>
                    </div>

                    <div class="collapse {{ activeFilterCount > 0 ? 'show' : '' }} mt-3" id="recipeFilters">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold text-secondary" for="filterIngredients">
                                    <i class="bi bi-basket me-1" aria-hidden="true"></i>Ingrédients
                                </label>
                                <select id="filterIngredients" name="ingredients[]" multiple
                                        class="filter-ingredients-select"
                                        data-ajax-url="{{ path('app_macuisine_recipe_ingredients_ajax') }}"></select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold text-secondary" for="filterUtensils">
                                    <i class="bi bi-tools me-1" aria-hidden="true"></i>Ustensiles
                                </label>
                                <select id="filterUtensils" name="utensils[]" multiple
                                        class="filter-utensils-select"
                                        data-options="{{ utensils|json_encode }}"
                                        data-initial="{{ selectedUtensils|json_encode }}"></select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold text-secondary" for="filterCategories">
                                    <i class="bi bi-tag me-1" aria-hidden="true"></i>Catégories
                                </label>
                                <select id="filterCategories" name="categories[]" multiple class="filter-categories-select">
                                    {% for category in categories %}
                                        <option value="{{ category.id }}" {{ category.id in selectedCategories ? 'selected' }}>{{ category.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            {% if searchQuery or activeFilterCount > 0 %}
                                <a href="{{ path('app_macuisine_feed') }}" class="btn btn-link text-secondary text-decoration-none">
                                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Réinitialiser
                                </a>
                            {% endif %}
                            <button type="submit" class="btn btn-primary rounded-pill px-3">
                                <i class="bi bi-funnel me-1" aria-hidden="true"></i>Appliquer les filtres
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        {% for recipe in recipes %}
            {% set isAuthor = app.user and recipe.author and app.user.id == recipe.author.id %}
            {% set isAdmin = app.user and 'ROLE_ADMIN' in app.user.roles %}
            <article class="card feed-post shadow-sm mb-3">
                <div class="card-body">
                    <header class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <span class="post-avatar">{{ recipe.author.username|first|upper ?? "" }}</span>
                            <div>
                                <div class="post-author">{{ recipe.author.username ?? "Compte supprimé" }}</div>
                                <div class="post-meta">
                                    {% if recipe.createdAt %}
                                        <i class="bi bi-clock me-1" aria-hidden="true"></i>{{ recipe.createdAt|date('d/m/Y à H:i') }}
                                    {% endif %}
                                    {% if recipe.updatedAt and recipe.updatedAt > recipe.createdAt %}
                                        <span class="ms-2"><i class="bi bi-pencil" aria-hidden="true"></i> modifiée</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {% if isAuthor or isAdmin %}
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_macuisine_recipe_edit', {'id': recipe.id}) }}">
                                            <i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Modifier
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="{{ path('app_macuisine_recipe_delete', {'id': recipe.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette recette ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recipe.id) }}">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-trash3 me-2" aria-hidden="true"></i>Supprimer
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        {% endif %}
                    </header>

                    <a href="{{ path('app_macuisine_recipe_show', {'id': recipe.id}) }}" class="text-decoration-none">
                        <div class="post-banner">
                        {% if recipe.image %}
                            {% set imgPath = 'uploads/recipes/' ~ recipe.image %}
                            {% if imgPath is ondisk %}
                                <picture>
                                    <source srcset="{{ asset(imgPath) | imagine_filter('big_avif') }}" type="image/avif">
                                    <source srcset="{{ asset(imgPath) | imagine_filter('big_webp') }}" type="image/webp">
                                    <source srcset="{{ asset(imgPath) | imagine_filter('big_png') }}" type="image/png">
                                    <source srcset="{{ asset(imgPath) | imagine_filter('big_jpeg') }}" type="image/jpeg">
                                    <img src="{{ asset(imgPath)}}" alt="{{ recipe.name }}" loading="lazy">
                                </picture>
                                
                            {% else %}
                                <div class="banner-fallback">
                                    <i class="bi bi-image-alt" aria-hidden="true"></i>
                                    <span>Image indisponible</span>
                                </div>
                            {% endif %}
                        {% else %}
                            <span class="recipe-emoji"><i class="bi bi-fork-knife" aria-hidden="true"></i></span>
                        {% endif %}
                        </div>
                        <h2 class="post-title">{{ recipe.name }}</h2>
                    </a>

                    {% if recipe.category or recipe.utensil|length > 0 %}
                        <div class="d-flex flex-wrap gap-1 mt-2 mb-2">
                            {% if recipe.category %}
                                <span class="badge rounded-pill text-bg-warning">
                                    <i class="bi bi-tag-fill me-1" aria-hidden="true"></i>{{ recipe.category.name }}
                                </span>
                            {% endif %}
                            {% for utensil in recipe.utensil %}
                                <span class="badge rounded-pill text-bg-light border">
                                    <i class="bi bi-tools me-1" aria-hidden="true"></i>{{ utensil.name }}
                                </span>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if recipe.refRecipeIngredients|length > 0 %}
                        {% for ri in recipe.refRecipeIngredients %}
                            <span class="mb-5">{{ ri.ingredient.name }}{% if not loop.last %} - {% endif %}</span>
                        {% endfor %}
                    {% else %}
                        <p class="text-body mb-3 mt-2" style="white-space: pre-line;">
                            Pas d'ingrédients renseignés
                        </p>
                    {% endif %}

                    <footer class="post-actions d-flex align-items-center justify-content-between border-top pt-2 mt-3">
                        <a href="{{ path('app_macuisine_recipe_show', {'id': recipe.id}) }}" class="btn">
                            <i class="bi bi-eye me-1" aria-hidden="true"></i>Voir la recette
                        </a>
                        <span class="post-meta">
                            <i class="bi bi-hash" aria-hidden="true"></i>{{ recipe.id }}
                        </span>
                    </footer>
                </div>
            </article>
        {% else %}
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-journal-plus display-4 text-secondary mb-3" aria-hidden="true"></i>
                    <h5>Le fil est vide</h5>
                    <p class="text-secondary mb-3">Soyez le premier à partager une recette avec la communauté&nbsp;!</p>
                    <a href="{{ path('app_macuisine_recipe_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Publier ma première recette
                    </a>
                </div>
            </div>
        {% endfor %}

    </div>
</div>
{% endblock %}

{% block importmap %}{{ importmap(['app', 'MaCuisine/recipe-filters']) }}{% endblock %}
