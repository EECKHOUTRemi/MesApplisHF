{% extends 'base.html.twig' %}

{% block title %}Nouvelle recette · MaCuisine{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 760px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_macuisine_index') }}" class="text-decoration-none">MaCuisine</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_macuisine_recipes') }}" class="text-decoration-none">Recettes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nouvelle</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary" style="width:56px;height:56px;font-size:1.5rem;">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
        </span>
        <div>
            <h1 class="h3 mb-1 fw-bold">Partager une nouvelle recette</h1>
            <p class="text-secondary mb-0">Faites découvrir votre savoir-faire à la communauté.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ include('MaCuisine/recipe/_form.html.twig', {'button_label': 'Publier la recette'}) }}
        </div>
    </div>

    <div class="mt-3">
        <a href="javascript:history.back()" class="btn btn-link text-decoration-none px-0">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour en arrière
        </a>
    </div>

</div>
{% endblock %}

{% block importmap %}{{ importmap(['app', 'MaCuisine/select-ingredient', 'MaCuisine/select-utensil']) }}{% endblock %}
