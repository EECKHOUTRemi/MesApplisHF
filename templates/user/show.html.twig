{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">User details</h1>
            <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to list
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <th scope="row" style="width: 200px;">Id</th>
                            <td>{{ user.id }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Email</th>
                            <td>{{ user.email }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Username</th>
                            <td>{{ user.username }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Roles</th>
                            <td>
                                {% for role in user.roles %}
                                    <span class="badge {{ role == 'ROLE_ADMIN' ? 'text-bg-danger' : 'text-bg-secondary' }}">{{ role }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">Password</th>
                            <td><code class="text-truncate d-inline-block" style="max-width: 100%;">{{ user.password }}</code></td>
                        </tr>
                        <tr>
                            <th scope="row">Verified</th>
                            <td>
                                {% if user.isVerified %}
                                    <span class="badge text-bg-success"><i class="bi bi-check-circle"></i> Yes</span>
                                {% else %}
                                    <span class="badge text-bg-warning"><i class="bi bi-x-circle"></i> No</span>
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex gap-2">
                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                {{ include('user/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
clude('user/_delete_form.html.twig') }}
{% endblock %}
