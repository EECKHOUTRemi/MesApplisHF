{% extends 'base.html.twig' %}

{% block title %}Détail mesure{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div class="d-flex align-items-center">
                    <a href="{{ path('app_MonPoids_measurement_index') }}" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <h1 class="fw-bold mb-0"><i class="bi bi-rulers text-primary me-2"></i>Détail mesure</h1>
                </div>
                <a href="{{ path('app_MonPoids_measurement_edit', {'id': measurement.id}) }}" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Modifier
                </a>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3 text-center h-100">
                                <p class="text-secondary small mb-1">Poitrine</p>
                                <p class="h4 fw-bold mb-0">{{ measurement.chest }} <small class="text-secondary">cm</small></p>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3 text-center h-100">
                                <p class="text-secondary small mb-1">Hanches</p>
                                <p class="h4 fw-bold mb-0">{{ measurement.hips }} <small class="text-secondary">cm</small></p>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3 text-center h-100">
                                <p class="text-secondary small mb-1">Cuisse</p>
                                <p class="h4 fw-bold mb-0">{{ measurement.thigh }} <small class="text-secondary">cm</small></p>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3 text-center h-100">
                                <p class="text-secondary small mb-1">Taille</p>
                                <p class="h4 fw-bold mb-0">{{ measurement.waist }} <small class="text-secondary">cm</small></p>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary">Date</dt>
                        <dd class="col-sm-8 mb-0">{{ measurement.createdAt ? measurement.createdAt|date('d/m/Y H:i') : '—' }}</dd>
                    </dl>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                {{ include('monpoids/measurement/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
