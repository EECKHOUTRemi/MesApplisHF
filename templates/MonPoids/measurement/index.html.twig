{% extends 'base.html.twig' %}

{% block title %}Mesures — Historique{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="fw-bold mb-1"><i class="bi bi-rulers text-primary me-2"></i>Historique des mesures</h1>
            <p class="text-secondary mb-0">Vos mensurations enregistrées.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_mon_poids_global') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_MonPoids_measurement_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Nouvelle mesure
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Poitrine (cm)</th>
                        <th>Hanches (cm)</th>
                        <th>Cuisse (cm)</th>
                        <th>Taille (cm)</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for measurement in measurements %}
                    <tr>
                        <td>{{ measurement.chest }}</td>
                        <td>{{ measurement.hips }}</td>
                        <td>{{ measurement.thigh }}</td>
                        <td>{{ measurement.waist }}</td>
                        <td>{{ measurement.createdAt ? measurement.createdAt|date('d/m/Y H:i') : '—' }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_MonPoids_measurement_show', {'id': measurement.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('app_MonPoids_measurement_edit', {'id': measurement.id}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Aucun enregistrement pour le moment.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
