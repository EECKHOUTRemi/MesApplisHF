{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form) }}
    {{ form_label(form.height, 'Taille (cm)') }}
    {{ form_widget(form.height) }}
    {{ form_label(form.weight, 'Poids (kg)') }}
    {{ form_widget(form.weight) }}
    {{ form_label(form.createdAt, 'Date de mesure') }}
    {{ form_widget(form.createdAt) }}
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary">
            <i class="bi bi-check-lg"></i> {{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('app_MonPoids_bmi_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </div>
{{ form_end(form) }}
