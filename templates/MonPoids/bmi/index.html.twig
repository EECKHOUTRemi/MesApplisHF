{% extends 'base.html.twig' %}

{% block title %}MAHF - IMC{% endblock %}

{% block body %}
<div class="container py-5">

    {{ include('_breadcrumb.html.twig', { items: [
        { label: 'Accueil', path: path('app_index') },
        { label: 'MonPoids', path: path('app_mon_poids_global') },
        { label: 'IMC' },
    ] }) }}

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Historique IMC</h1>
            <p class="text-secondary mb-0">Vos calculs d'indice de masse corporelle.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_mon_poids_global') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_MonPoids_bmi_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Nouveau calcul
            </a>
        </div>
    </div>

    {% set chartDefault = bmis|length > 2 %}
    {% if chartDefault %}
        <ul class="nav nav-pills mb-3" id="bmiViewTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link{{ chartDefault ? '' : ' active' }}" id="table-tab" data-bs-toggle="pill" data-bs-target="#table-view" type="button" role="tab" aria-controls="table-view" aria-selected="{{ chartDefault ? 'false' : 'true' }}">
                    <i class="bi bi-table me-1"></i> Tableau
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link{{ chartDefault ? ' active' : '' }}" id="chart-tab" data-bs-toggle="pill" data-bs-target="#chart-view" type="button" role="tab" aria-controls="chart-view" aria-selected="{{ chartDefault ? 'true' : 'false' }}">
                    <i class="bi bi-graph-up me-1"></i> Graphique
                </button>
            </li>
        </ul>
    {% endif %}

    <div class="tab-content" id="bmiViewTabsContent">
        {% if chartDefault %}
        <div class="tab-pane fade{{ chartDefault ? ' show active' : '' }}" id="chart-view" role="tabpanel" aria-labelledby="chart-tab">
            <div class="card shadow-sm p-3 mb-3">
                <h2 class="h6 fw-semibold mb-2">IMC</h2>
                <div style="height: 360px;" data-controller="bmi-chart">
                    {{ render_chart(bmiChart) }}
                </div>
            </div>
            <div class="card shadow-sm p-3">
                <h2 class="h6 fw-semibold mb-2">Poids</h2>
                <div style="height: 360px;">
                    {{ render_chart(weightChart) }}
                </div>
            </div>
        </div>
        {% endif %}

        <div class="tab-pane fade{{ chartDefault ? '' : ' show active' }}" id="table-view" role="tabpanel" aria-labelledby="table-tab">
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Taille (cm)</th>
                                <th>Poids (kg)</th>
                                <th>IMC</th>
                                <th>Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for bmi in bmis %}
                            <tr>
                                <td>{{ bmi.height }}</td>
                                <td>{{ bmi.weight }}</td>
                                <td><span class="badge bg-{% if bmi.bmi < 18.5 %}danger{% elseif bmi.bmi < 25 %}success{% elseif bmi.bmi < 30 %}warning{% else %}danger{% endif %}-subtle text-{% if bmi.bmi < 18.5 %}danger{% elseif bmi.bmi < 25 %}success{% elseif bmi.bmi < 30 %}warning{% else %}danger{% endif %} fs-6">{{ bmi.bmi }}</span></td>
                                <td>{{ bmi.createdAt ? bmi.createdAt|date('d/m/Y H:i') : '—' }}</td>
                                <td class="text-end">
                                    <a href="{{ path('app_MonPoids_bmi_show', {'id': bmi.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('app_MonPoids_bmi_edit', {'id': bmi.id}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-secondary py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Aucun enregistrement pour le moment.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
