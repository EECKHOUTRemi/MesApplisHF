{# Fil d'Ariane partagé.

   Attend `items` : une liste de dictionnaires { label, path }.
   Le dernier élément représente la page courante : son `path` est ignoré et il
   est marqué `aria-current="page"`.
   Un élément sans `path` s'affiche en texte simple (utile pour un niveau
   purement structurel comme « Administration », qui n'a pas de route).

   {{ include('_breadcrumb.html.twig', { items: [
       { label: 'MaCuisine', path: path('app_macuisine_index') },
       { label: 'Recettes',  path: path('app_macuisine_feed') },
       { label: recipe.name },
   ] }) }}
#}
{% if items|default([])|length > 0 %}
    <nav aria-label="Fil d'Ariane" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            {% for item in items %}
                {% if loop.last %}
                    <li class="breadcrumb-item active" aria-current="page">{{ item.label }}</li>
                {% elseif item.path is defined %}
                    <li class="breadcrumb-item">
                        <a href="{{ item.path }}" class="text-decoration-none">{{ item.label }}</a>
                    </li>
                {% else %}
                    <li class="breadcrumb-item">{{ item.label }}</li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>
{% endif %}
