<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('icons/favicon.ico') }}?v=5" type="image/x-icon">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
            <style>
                /* Astérisque rouge devant le label de tout champ obligatoire */
                .required::before {
                    content: "*";
                    color: var(--bs-danger, #dc3545);
                    margin-right: 0.25rem;
                    font-weight: bold;
                }

                /* Fil d'Ariane (_breadcrumb.html.twig), présent sur presque toutes les pages */
                .app-breadcrumb .breadcrumb {
                    --bs-breadcrumb-divider: '';
                    align-items: center;
                    flex-wrap: wrap;
                    row-gap: .15rem;
                    font-size: .875rem;
                }
                /* Chevron simple à la place du "/" par défaut de Bootstrap */
                .app-breadcrumb .breadcrumb-item + .breadcrumb-item {
                    padding-left: .25rem;
                }
                .app-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                    content: "\203A";
                    font-size: 1.1em;
                    line-height: 1;
                    color: var(--bs-gray-400, #ced4da);
                    padding-right: .25rem;
                }
                .app-breadcrumb .breadcrumb-item a,
                .app-breadcrumb .breadcrumb-item-plain {
                    display: inline-flex;
                    align-items: center;
                    padding: .15rem .45rem;
                    border-radius: .375rem;
                    color: var(--bs-secondary-color, #6c757d);
                    text-decoration: none;
                    transition: color .15s ease, background-color .15s ease;
                }
                .app-breadcrumb .breadcrumb-item a:hover,
                .app-breadcrumb .breadcrumb-item a:focus-visible {
                    color: var(--bs-primary, #0d6efd);
                    background-color: var(--bs-secondary-bg, #e9ecef);
                }
                .app-breadcrumb .breadcrumb-item.active {
                    display: inline-flex;
                    align-items: center;
                    padding: .15rem .45rem;
                    color: var(--bs-emphasis-color, #212529);
                    font-weight: 600;
                }
                /* Les libellés dynamiques (nom de recette, pseudo…) peuvent être longs :
                   on les tronque plutôt que de casser la mise en page. */
                .app-breadcrumb .breadcrumb-label {
                    display: inline-block;
                    max-width: 20ch;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                    vertical-align: bottom;
                }
                @media (max-width: 575.98px) {
                    .app-breadcrumb .breadcrumb-label {
                        max-width: 12ch;
                    }
                }
            </style>
            {% if is_granted('ROLE_USER') %}
                <style>
                    body {
                        padding-top: 70px;
                    }
                    /* Couleurs des icônes de la navbar — :hover et :focus-visible
                       pour donner le même retour visuel au clavier qu'à la souris */
                    #logout-icon {
                        color: red;
                    }
                    a:hover #logout-icon,
                    a:focus-visible #logout-icon {
                        color: pink;
                    }
                    #adminDropdown {
                        color: yellow;
                    }
                    #adminDropdown:hover,
                    #adminDropdown:focus-visible {
                        color: #fffbb2;
                    }
                    /* Pastille de notification posée *sur* l'icône (messages non lus,
                       demandes d'ami) : ancrée dans le coin haut-droit de son cadre.
                       Le liseré reprend le fond de la navbar pour la détacher du
                       pictogramme. */
                    .nav-badge {
                        top: 0;
                        right: -.35rem;
                        font-size: .55rem;
                        line-height: 1;
                        padding: .25em .4em;
                        min-width: 1.4em;
                        border: 2px solid var(--bs-dark);
                    }
                </style>
            {% endif %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous" defer></script>
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        {% if is_granted('ROLE_USER') %}
            {% include '_navbar.html.twig' %}
        {% endif %}

        <main class="flex-grow-1">
            {% set flashes = app.flashes(['success', 'danger', 'warning']) %}
            {% if flashes is not empty %}
                <div class="container mt-3">
                    {% for label, messages in flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} alert-dismissible fade show py-2 px-3 shadow-sm" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Fermer"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}

            {% block body %}{% endblock %}
        </main>

        <footer class="border-top bg-light mt-auto py-3">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2 small text-secondary">
                <span style="color: #474747">&copy; {{ "now"|date("Y") }} MesApplisHF</span>
                <nav aria-label="Liens du site">
                    <a href="{{ path('app_brochure_index') }}" class="text-decoration-none me-3" style="color: #474747">Découvrir</a>
                    <a href="{{ path('app_terms') }}" class="text-decoration-none me-3" style="color: #474747">CGU</a>
                    <a href="{{ path('app_privacy') }}" class="text-decoration-none" style="color: #474747">Confidentialité</a>
                </nav>
            </div>
        </footer>

        {% if is_granted('ROLE_USER') %}
            {% include '_chat_realtime.html.twig' %}
        {% endif %}
    </body>
</html>
