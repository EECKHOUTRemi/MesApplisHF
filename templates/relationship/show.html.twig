{% extends 'base.html.twig' %}

{% block title %}Relationship{% endblock %}

{% block body %}
    <h1>Relationship</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ relationship.id }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ relationship.status }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ relationship.createdAt ? relationship.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ relationship.updatedAt ? relationship.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_relationship_index') }}">back to list</a>

    <a href="{{ path('app_relationship_edit', {'id': relationship.id}) }}">edit</a>

    {{ include('relationship/_delete_form.html.twig') }}
{% endblock %}
