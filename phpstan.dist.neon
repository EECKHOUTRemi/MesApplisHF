includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
        - tests
    symfony:
        # Conteneur de test : il contient les services de l'application *et* les
        # doublures déclarées dans config/services_test.yaml, que `tests/` référence.
        containerXmlPath: var/cache/test/App_KernelTestDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
